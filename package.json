{
  "name": "vivim-omega",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "contracts",
    "host",
    "shim",
    "platform",
    "plugins/*",
    "packs/*",
    "surfaces/*",
    "examples/*",
    "tooling",
    "sdk",
    "testkit"
  ],
  "scripts": {
    "omega:setup": "bun install",
    "omega:test": "bun test",
    "omega:test:host": "bun test host tooling/gates",
    "omega:test:plugins": "bun test plugins packs",
    "omega:test:surfaces": "bun test surfaces sdk testkit",
    "omega:quick": "bun run tooling/gates/gate.ts --quick",
    "omega:gate": "bun run tooling/gates/gate.ts",
    "omega:decisions": "bun run tooling/gates/decisions.ts",
    "omega:questions": "bun run tooling/gates/decisions.ts --write",
    "omega:new-decision": "bun run tooling/gates/new-decision.ts",
    "omega:round-close": "bun run tooling/gates/round-close.ts",
    "omega:bench": "bun run tooling/bench/bench.ts",
    "omega:probe": "bun run tooling/bench/vault-probe.ts",
    "omega:containment": "bun run platform/src/containment.ts",
    "omega:generate": "bun run tooling/generate/generate.ts",
    "omega:fixtures:import": "bun run tooling/harvest/fixture-import.ts",
    "omega:fixtures:check": "bun run tooling/harvest/fixture-import.ts --check",
    "omega:triage:split": "bun run tooling/harvest/triage-split.ts",
    "omega:status": "bun run tooling/gates/status.ts",
    "omega:demo": "bun run tooling/demo/demo.ts",
    "omega:portrait": "bun run tooling/portrait/portrait.ts",
    "omega:host": "bun run host/src/main.ts"
  },
  "dependencies": {
    "zod": "^4.6.2"
  }
}
