          "bootPhase": 1,
          "grant": {
            "capabilities": [
              "port:host.compartment.spawn@1",
              "port:host.compartment.terminate@1",
              "port:host.compartment.stats@1",
              "host.compartment.admin",
              "port:echo.ping@1"
            ],
            "contracts": [
